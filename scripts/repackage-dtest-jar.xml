<project basedir="." default="repackage-meta-inf" name="repackage-dtest-jar">
    <property name="source.file" value="${sourceFile}" />

    <target name="repackage-meta-inf" description="Repackage JAR removing signatures, license files and multi-release classes">
        <basename property="source.filename" file="${source.file}" suffix=".jar"/>
        <property name="work.dir" value="${basedir}/repackage-${source.filename}"/>

        <delete dir="${work.dir}/**" quiet="true"/>

        <unzip src="${source.file}" dest="${work.dir}" overwrite="false">
            <patternset excludes="META-INF/license/**"/>
        </unzip>

        <delete file="${source.file}" quiet="true"/>

        <jar jarfile="${source.file}" duplicate="preserve">
            <fileset dir="${work.dir}">
                <exclude name="META-INF/*.SF"/>
                <exclude name="META-INF/*.DSA"/>
                <exclude name="META-INF/*.RSA"/>
                <exclude name="META-INF/license/**"/>
                <exclude name="META-INF/versions/17/**"/>
                <exclude name="META-INF/versions/19/**"/>
                <exclude name="META-INF/versions/20/**"/>
                <exclude name="META-INF/versions/21/**"/>
                <exclude name="META-INF/versions/22/**"/>
            </fileset>
        </jar>

        <delete dir="${work.dir}" quiet="true"/>
    </target>
</project>